rules_version = '2';

// =====================================================================
// CrimsonCloudHR — Firestore Security Rules
// Shared by the HR app AND the public Job Portal (same Firebase project).
//
// Roles live in users/{uid}.role (case-insensitive):
//   admin       → full access
//   hr          → manager + can edit employee records (not payroll/settings)
//   supervisor  → manager: reads everything HR-related, approves leave /
//                 timesheets / requests, runs recruitment. NO payroll or
//                 system-settings writes, NO employee-record writes.
//   employee/ess→ self-service only (own records, matched by employeeId)
//
// Records are owned by EMPLOYEE ID (users/{uid}.employeeId), not by uid,
// because that's how the app links timesheets/leave/requests to people.
// NOTE: every get() below costs 1 document read (cached per request).
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- helpers ----------------
    function signedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return signedIn()
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'anonymous';
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function profile() {
      return get(profilePath()).data;
    }

    function hasProfile() {
      return signedIn() && !isAnonymous() && exists(profilePath());
    }

    function role() {
      return string(profile().get('role', '')).lower();
    }

    function isActive() {
      return string(profile().get('status', 'Enabled')).lower() != 'disabled';
    }

    function isAdmin()   { return hasProfile() && isActive() && role() == 'admin'; }
    function isHR()      { return hasProfile() && isActive() && role() in ['admin', 'hr']; }
    function isManager() { return hasProfile() && isActive() && role() in ['admin', 'hr', 'supervisor']; }
    function isStaff()   { return hasProfile() && isActive(); }

    function myEmpId() {
      return profile().get('employeeId', '__none__');
    }

    // The codebase uses both `employeeId` and `employee_id`; accept either.
    function ownsExisting() {
      return isStaff() && (
        resource.data.get('employeeId', null) == myEmpId() ||
        resource.data.get('employee_id', null) == myEmpId()
      );
    }

    function changes() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isTime(v)  { return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'); }
    function isDate(v)  { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function shortStr(v, max) { return v is string && v.size() <= max; }

    // ---- Philippine server clock (UTC+8, no DST) ----
    function manilaNow() { return request.time + duration.value(8, 'h'); }
    function pad2(n) { return n < 10 ? '0' + string(n) : string(n); }
    function manilaToday() {
      return string(manilaNow().year()) + '-' + pad2(manilaNow().month()) + '-' + pad2(manilaNow().day());
    }
    function minutesOf(hhmm) { return int(hhmm.split(':')[0]) * 60 + int(hhmm.split(':')[1]); }
    function nearServerTime(hhmm) {
      return math.abs(minutesOf(hhmm) - (manilaNow().hours() * 60 + manilaNow().minutes())) <= 5;
    }
    // Same formula as computeHours() in src/app/schemas/timesheet.ts:
    // 1h unpaid break once the span reaches 9h; first 8h regular, rest OT.
    function workedHours(d) {
      let span = (minutesOf(d.timeOut) - minutesOf(d.timeIn)) / 60.0;
      return span >= 9 ? span - 1 : span;
    }
    function hoursMatch(d) {
      return d.get('timeOut', '') == ''
        ? d.get('hoursWorked', 0) == 0 && d.get('overtime', 0) == 0
        : isTime(d.timeIn) && isTime(d.timeOut)
          && minutesOf(d.timeOut) > minutesOf(d.timeIn)
          && math.abs(d.hoursWorked - (workedHours(d) > 8 ? 8 : workedHours(d))) <= 0.011
          && math.abs(d.overtime - (workedHours(d) > 8 ? workedHours(d) - 8 : 0)) <= 0.011;
    }

    // =================================================================
    // PUBLIC JOB PORTAL
    // =================================================================

    // Anyone (even logged out) can read OPEN job postings.
    // Queries must include where('status', '==', 'Open') unless manager.
    match /jobs/{jobId} {
      allow read: if resource.data.status == 'Open' || isManager();
      allow create, update: if isManager();
      allow delete: if isHR();
    }

    // Applicants sign in ANONYMOUSLY in the job portal, so writes are
    // never unauthenticated. Each applicant only ever sees their own rows.
    match /applicants/{appId} {
      allow create: if isManager() || signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'Pending'
        && shortStr(request.resource.data.name, 120)
        && shortStr(request.resource.data.email, 200)
        && shortStr(request.resource.data.get('coverLetter', ''), 5000)
        && shortStr(request.resource.data.get('skills', ''), 2000)
        && shortStr(request.resource.data.get('experience', ''), 3000)
        && shortStr(request.resource.data.get('education', ''), 2000)
        && shortStr(request.resource.data.get('resumeURL', ''), 500)
        && request.resource.data.keys().size() <= 20;
      allow read: if isManager()
        || (signedIn() && resource.data.get('ownerUid', null) == request.auth.uid);
      allow update: if isManager();
      allow delete: if isHR()
        || (signedIn() && resource.data.get('ownerUid', null) == request.auth.uid);
    }

    match /interviews/{id}      { allow read, write: if isManager(); }
    match /evaluations/{id}     { allow read, write: if isManager(); }
    match /hiringDecisions/{id} { allow read, write: if isManager(); }

    // =================================================================
    // USERS (accounts + roles = "system settings")
    // =================================================================
    match /users/{userId} {
      allow read: if isManager()
        || (signedIn() && request.auth.uid == userId)
        || (signedIn() && resource.data.get('email', '') == request.auth.token.email);

      // Self-registration (ClaimAccount): only as a plain employee, and only
      // when linked to an employees/ record that carries the same email.
      function linkedEmployee() {
        return get(/databases/$(database)/documents/employees/$(request.resource.data.employeeDocId)).data;
      }
      allow create: if isAdmin() || (
        signedIn() && !isAnonymous()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && string(request.resource.data.role).lower() in ['employee', 'ess']
        && request.resource.data.get('status', 'Enabled') == 'Enabled'
        && linkedEmployee().email == request.auth.token.email
        && linkedEmployee().employeeId == request.resource.data.employeeId
      );

      // Users may edit ONLY these personal fields on their own profile —
      // never role, status, IDs, leave balances, position or salary.
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == userId
        && changes().hasOnly(['firstName', 'lastName', 'middleName', 'username', 'phone', 'address',
                              'dob', 'gender', 'civilStatus', 'emergencyName', 'emergencyRelation',
                              'emergencyPhone', 'imageUrl', 'lastLogin'])
      );
      allow delete: if isAdmin();
    }

    // =================================================================
    // EMPLOYEE MASTER RECORDS
    // =================================================================
    match /employees/{empDocId} {
      allow read: if isManager()
        || (signedIn() && resource.data.get('email', '') == request.auth.token.email);
      allow create, delete: if isHR();
      allow update: if isHR() || (
        signedIn() && resource.data.get('email', '') == request.auth.token.email
        && changes().hasOnly(['phone', 'address', 'dob', 'gender', 'civilStatus',
                              'emergencyName', 'emergencyRelation', 'emergencyPhone',
                              'profileImage', 'photoURL'])
      );
    }

    // =================================================================
    // ATTENDANCE / TIME LOGS — tamper-proof
    //  • one record per employee per day: doc ID must be "<employeeId>_<date>"
    //  • date must be TODAY and times within ±5 min of the server clock
    //    (Asia/Manila), so nobody can back-date or invent hours
    //  • hoursWorked/overtime are recomputed here from timeIn/timeOut
    //  • employees can never approve, edit after time-out, or delete
    //  • managers can approve/correct OTHER people's records, never their own
    // =================================================================
    match /timesheets/{tsId} {
      allow read: if isManager() || ownsExisting();

      allow create: if isAdmin() || (
        isStaff()
        && tsId == request.resource.data.employeeId + '_' + request.resource.data.date
        && request.resource.data.employeeId == myEmpId()
        && request.resource.data.status == 'Submitted'
        && request.resource.data.date == manilaToday()
        && isTime(request.resource.data.timeIn)
        && nearServerTime(request.resource.data.timeIn)
        && request.resource.data.timeInAt == request.time
        && request.resource.data.timeOut == ''
        && request.resource.data.hoursWorked == 0
        && request.resource.data.overtime == 0
      );

      allow update: if isAdmin()
        || (isManager() && !ownsExisting()
            && !changes().hasAny(['employeeId', 'employee_id', 'date', 'timeInAt', 'timeOutAt'])
            && hoursMatch(request.resource.data))
        || (
          ownsExisting()
          && resource.data.status == 'Submitted'
          && resource.data.date == manilaToday()
          && resource.data.get('timeOut', '') == ''
          && changes().hasOnly(['timeOut', 'timeOutAt', 'hoursWorked', 'overtime'])
          && isTime(request.resource.data.timeOut)
          && nearServerTime(request.resource.data.timeOut)
          && request.resource.data.timeOutAt == request.time
          && hoursMatch(request.resource.data)
        );
      allow delete: if isAdmin();
    }

    // =================================================================
    // LEAVE + GENERIC REQUESTS (ownership via employee_id)
    // Employees file and may cancel while still Pending. Managers decide on
    // OTHER people's requests only (no self-approval).
    // =================================================================
    // Yearly credits in working days — same numbers as src/app/lib/leavePolicy.ts.
    function leaveLimit(t) {
      return {
        'Vacation Leave': 15, 'Sick Leave': 15, 'Emergency Leave': 3, 'Bereavement Leave': 3,
        'Paternity Leave': 7, 'Study Leave': 30, 'Maternity Leave': 105
      }.get(t, 0);
    }
    function balancePath(empId, startDate) {
      return /databases/$(database)/documents/leaveBalances/$(empId + '_' + startDate[0:4]);
    }
    function usedIn(path, t) {
      return exists(path) ? get(path).data.used.get(t, 0) : 0;
    }
    function dateOf(d) { return timestamp.date(int(d[0:4]), int(d[5:7]), int(d[8:10])); }

    // Shape + credit check for a new Pending request. Pending days aren't
    // reserved server-side; approval is the hard gate (see below).
    function validLeave(r) {
      return r.status == 'Pending'
        && isDate(r.start_date) && isDate(r.end_date)
        && r.end_date >= r.start_date
        && r.start_date[0:4] == r.end_date[0:4]
        && leaveLimit(r.leave_type) > 0
        && r.total_days is int && r.total_days >= 1
        && r.total_days <= (dateOf(r.end_date) - dateOf(r.start_date)).seconds() / 86400 + 1
        && r.total_days + usedIn(balancePath(r.employee_id, r.start_date), r.leave_type) <= leaveLimit(r.leave_type)
        && shortStr(r.get('reason', ''), 1000);
    }

    // Approving must add exactly this request's days to the balance in the
    // same batch, and can't go over the yearly limit.
    function approvalBooked(id) {
      let path = balancePath(resource.data.employee_id, resource.data.start_date);
      let t = resource.data.leave_type;
      return existsAfter(path)
        && getAfter(path).data.lastRequestId == id
        && getAfter(path).data.used.get(t, 0) == usedIn(path, t) + resource.data.total_days
        && getAfter(path).data.used.get(t, 0) <= leaveLimit(t);
    }

    match /leaveRequests/{id} {
      allow read: if isManager() || ownsExisting();
      allow create: if (
          isHR() && request.resource.data.employee_id != myEmpId() && validLeave(request.resource.data)
        ) || (
          isStaff() && request.resource.data.employee_id == myEmpId() && validLeave(request.resource.data)
        );
      allow update: if isAdmin()
        || (isManager() && !ownsExisting()
            && !changes().hasAny(['employee_id', 'start_date', 'end_date', 'leave_type', 'total_days'])
            && (request.resource.data.status != 'Approved' || resource.data.status == 'Approved' || approvalBooked(id)))
        || (
          ownsExisting()
          && resource.data.status == 'Pending'
          && changes().hasOnly(['status'])
          && request.resource.data.status == 'Cancelled'
        );
      allow delete: if isAdmin();
    }

    // Approved leave days per employee per year. Only changed by an approval
    // (Pending → Approved in the same batch) or by an admin rebuild.
    match /leaveBalances/{id} {
      allow read: if isManager() || (isStaff() && resource.data.employeeId == myEmpId());
      allow create, update: if isAdmin() || (isManager() && validBooking(id));
      allow delete: if isAdmin();
    }

    function validBooking(id) {
      let reqPath = /databases/$(database)/documents/leaveRequests/$(request.resource.data.lastRequestId);
      let before = get(reqPath).data;
      let t = before.leave_type;
      let oldUsed = resource == null ? {} : resource.data.used;
      return before.status == 'Pending'
        && getAfter(reqPath).data.status == 'Approved'
        && before.employee_id != myEmpId()
        && id == before.employee_id + '_' + before.start_date[0:4]
        && request.resource.data.employeeId == before.employee_id
        && request.resource.data.used.get(t, 0) == oldUsed.get(t, 0) + before.total_days
        && request.resource.data.used.diff(oldUsed).affectedKeys().hasOnly([t]);
    }

    match /requests/{id} {
      allow read: if isManager() || ownsExisting();
      allow create: if (isHR() && request.resource.data.employee_id != myEmpId()) || (
        isStaff()
        && request.resource.data.employee_id == myEmpId()
        && request.resource.data.status == 'Pending'
        && shortStr(request.resource.data.get('reason', ''), 1000)
      );
      allow update: if isAdmin()
        || (isManager() && !ownsExisting() && !changes().hasAny(['employee_id', 'details']))
        || (
          ownsExisting()
          && resource.data.status == 'Pending'
          && changes().hasOnly(['status'])
          && request.resource.data.status == 'Cancelled'
        );
      allow delete: if isAdmin();
    }

    // =================================================================
    // PERFORMANCE, TRAINING, NOTIFICATIONS
    // =================================================================
    // Evaluations are written once by a manager about SOMEONE ELSE and are
    // then final: only an admin can correct or delete them. Employees read only.
    match /performance_evaluations/{id} {
      allow read: if isManager() || (isStaff() && (
        resource.data.get('employeeId', null) == myEmpId() ||
        resource.data.get('customEmployeeId', null) == myEmpId()
      ));
      allow create: if isAdmin() || (
        isManager()
        && request.resource.data.get('employeeId', '') != myEmpId()
        && request.resource.data.get('customEmployeeId', '') != myEmpId()
      );
      allow update, delete: if isAdmin();
    }

    // 360° reviews (src/app/lib/evaluation.ts). A manager opens a review by
    // creating one request per reviewer (self + peers). Each reviewer answers
    // once; the response ID equals the request ID so the two can be matched.
    // Raw answers are visible only to managers and the reviewer, never to the
    // person being reviewed (they see the combined performance_evaluation).
    match /evaluation_requests/{id} {
      allow read: if isManager()
        || (isStaff() && resource.data.reviewerEmpId == myEmpId());
      allow create: if isManager()
        && request.resource.data.subjectEmpId != myEmpId()
        && id == request.resource.data.periodId + '__' + request.resource.data.subjectEmpId + '__'
                 + request.resource.data.type + '__' + request.resource.data.reviewerEmpId
        && (
          (request.resource.data.type == 'self'
            && request.resource.data.reviewerEmpId == request.resource.data.subjectEmpId)
          || (request.resource.data.type == 'peer'
            && request.resource.data.reviewerEmpId != request.resource.data.subjectEmpId)
        );
      allow delete: if isManager();
      allow update: if isAdmin();
    }

    function validEvalResponse(id) {
      let r = request.resource.data;
      return r.reviewerUid == request.auth.uid
        && r.reviewerEmpId == myEmpId()
        && r.score is number && r.score >= 1 && r.score <= 5
        && r.answers is map
        && id == r.periodId + '__' + r.subjectEmpId + '__' + r.type + '__' + r.reviewerEmpId;
    }

    match /evaluation_responses/{id} {
      allow read: if isManager()
        || (isStaff() && resource.data.reviewerUid == request.auth.uid);
      // Self/peer: only with a matching request addressed to you.
      // Supervisor: any manager, never about themselves. Create-only = once.
      allow create: if isStaff() && validEvalResponse(id) && (
        (request.resource.data.type in ['self', 'peer']
          && exists(/databases/$(database)/documents/evaluation_requests/$(id)))
        || (request.resource.data.type == 'supervisor'
          && isManager()
          && request.resource.data.subjectEmpId != myEmpId())
      );
      allow update, delete: if isAdmin();
    }

    // Training assignments are managed by HR/supervisors; employees read only.
    match /trainings/{id} {
      allow read: if isManager() || ownsExisting();
      allow create, update, delete: if isManager();
    }

    // Queries must filter: or(type == 'Announcement', employeeId == mine).
    match /notifications/{id} {
      allow read: if isManager() || (isStaff() && (
        resource.data.get('type', '') == 'Announcement' ||
        resource.data.get('employeeId', null) == myEmpId()
      ));
      allow create: if isManager();
      allow update: if isManager() || (
        isStaff()
        && resource.data.get('employeeId', null) == myEmpId()
        && changes().hasOnly(['isRead'])
      );
      allow delete: if isAdmin();
    }

    // =================================================================
    // PAYROLL — read by managers / owner, WRITE ADMIN ONLY
    // =================================================================
    match /employeePayrolls/{id} {
      allow read: if isManager() || ownsExisting();
      allow write: if isAdmin();
    }
    match /payrollPeriods/{id} {
      allow read: if isManager();
      allow write: if isAdmin();
    }
    match /claims/{id} {
      allow read: if isManager() || ownsExisting();
      allow write: if isAdmin();
    }

    // =================================================================
    // SYSTEM SETTINGS + AUDIT LOGS — admin only
    // =================================================================
    match /settings/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Signed-in users may append entries about THEMSELVES; nobody can edit
    // or delete history. (Pre-login failures can't be logged — by design,
    // unauthenticated writes are blocked. Firebase Auth throttles brute force.)
    match /audit_logs/{id} {
      allow create: if signedIn() && !isAnonymous()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.timestamp == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
