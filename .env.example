# Copy to .env.local (git-ignored) and fill in.
# reCAPTCHA (Fraud Defense / Enterprise) SITE key (public), from Firebase App Check or Google Cloud Console
VITE_RECAPTCHA_SITE_KEY=

# Optional: a fixed App Check debug token for local dev / CI.
# Leave empty to have Firebase print a new one in the browser console.
VITE_APPCHECK_DEBUG_TOKEN=
