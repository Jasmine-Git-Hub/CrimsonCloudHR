{
  "name": "crimsoncloudhr",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "seed:dry": "node scripts/seed-mock-data.mjs",
    "seed": "node scripts/seed-mock-data.mjs --confirm",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy": "vite build && firebase deploy --only hosting",
    "test:rules": "firebase emulators:exec --only firestore --project demo-crimsoncloudhr \"node --test tests/firestore.rules.test.mjs\"",
    "test:unit": "node --test tests/phPayroll.test.ts tests/evaluation.test.ts tests/leavePolicy.test.ts",
    "test": "npm run test:unit && npm run test:rules"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-slot": "1.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "firebase": "^12.10.0",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-router": "7.13.0",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "4.1.12",
    "@vitejs/plugin-react": "4.7.0",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^14.27.0",
    "tailwindcss": "4.1.12",
    "vite": "^6.4.1"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  }
}
